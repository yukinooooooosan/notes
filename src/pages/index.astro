---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL;
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Yukino Notes"
  description="個人制作のログ、設計メモ、技術メモ。"
>
  <section class="hero">
    <p class="eyebrow">Production Notes</p>
    <h1>制作の途中を、あとから読める形で残す場所。</h1>
    <p>
      ゲーム、Web、文章、設計のメモをまとめます。本体HPはプロフィールとして軽く保ち、
      ここでは制作ログを育てていきます。
    </p>
  </section>

  <section class="note-list" aria-labelledby="latest-notes">
    <h2 id="latest-notes">Latest Notes</h2>
    {
      notes.map((note) => (
        <article class="note-item">
          <a class="note-card-link" href={`${basePath}notes/${note.id}/`}>
            <time datetime={note.data.pubDate.toISOString()}>
              {note.data.pubDate.toLocaleDateString("ja-JP")}
            </time>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>
