---
const {
  title = "Yukino Notes",
  description = "Personal production notes for Yukino's projects."
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Yukino Notes</a>
      <nav aria-label="Primary navigation">
        <a href="/">Notes</a>
        <a href="https://yukinooooooosan.cc/">Profile</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
