---
const {
  title = "Yukino Notes",
  description = "Personal production notes for Yukino's projects."
} = Astro.props;

const gaMeasurementId = "G-8WPQNSFFEQ";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", gaMeasurementId);
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Yukino Notes</a>
      <nav aria-label="Primary navigation">
        <a href="/">Notes</a>
        <a href="https://yukinooooooosan.cc/">Profile</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      const colorCodePattern = /#(?:[0-9a-fA-F]{6})(?![0-9a-fA-F])/g;

      /**
       * @param {string} text
       * @returns {boolean}
       */
      function hasColorCode(text) {
        colorCodePattern.lastIndex = 0;
        const result = colorCodePattern.test(text || "");
        colorCodePattern.lastIndex = 0;
        return result;
      }

      /**
       * @param {string} color
       * @returns {HTMLSpanElement}
       */
      function createColorSwatch(color) {
        const swatch = document.createElement("span");
        swatch.className = "color-swatch";
        swatch.style.backgroundColor = color;
        swatch.title = color;
        swatch.setAttribute("aria-label", `${color}の色見本`);
        return swatch;
      }

      /**
       * @param {Text} node
       */
      function enhanceTextNode(node) {
        const text = node.nodeValue;
        if (!text || !hasColorCode(text)) {
          return;
        }

        colorCodePattern.lastIndex = 0;
        const fragment = document.createDocumentFragment();
        let cursor = 0;
        let match;

        while ((match = colorCodePattern.exec(text)) !== null) {
          const color = match[0];
          fragment.append(document.createTextNode(text.slice(cursor, match.index)));
          const token = document.createElement("span");
          token.className = "color-token";
          token.append(document.createTextNode(color), createColorSwatch(color));
          fragment.append(token);
          cursor = match.index + color.length;
        }

        fragment.append(document.createTextNode(text.slice(cursor)));
        node.parentNode?.replaceChild(fragment, node);
      }

      /**
       * @param {HTMLElement} code
       */
      function enhanceCodeBlock(code) {
        const walker = document.createTreeWalker(code, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            return hasColorCode(node.nodeValue || "")
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_SKIP;
          }
        });

        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(enhanceTextNode);
      }

      document.querySelectorAll(".prose").forEach((prose) => {
        prose.querySelectorAll("code").forEach((code) => {
          if (code.closest("pre")) {
            enhanceCodeBlock(code);
            return;
          }
          const colors = code.textContent?.match(colorCodePattern);
          if (!colors) return;
          code.insertAdjacentElement("afterend", createColorSwatch(colors[0]));
        });

        const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent) return NodeFilter.FILTER_REJECT;
            if (parent.closest("a, code, pre, script, style")) {
              return NodeFilter.FILTER_REJECT;
            }
            return hasColorCode(node.nodeValue || "")
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_SKIP;
          }
        });

        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(enhanceTextNode);
      });
    </script>
  </body>
</html>
